# Copy to .env (gitignored) and fill in. backend/app/config.py reads these
# from the process environment — see docs/14-phase2-postgres-architecture.md,
# docs/15-security-and-rls.md, and docs/20-render-deployment.md.

# Postgres connection string. In production/normal local dev this is the
# Supabase project's connection string, authenticated as a privileged
# server-side role (Supabase's `service_role`, or an equivalent role granted
# BYPASSRLS) — never the anon key. Example shape:
#   postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Only read by the test suite (backend/tests/conftest.py), never by the app.
# Must point at a disposable Postgres you're happy for tests to create/drop
# databases against — never the same value as DATABASE_URL / production.
# Defaults to a local Postgres if unset.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Native AI task layer (backend/app/ai.py) — only needed for AI-assisted
# extraction endpoints; the rest of the app runs without them.
OPENAI_API_KEY=
CP_AI_MODEL=gpt-4o-mini

# --- Authentication (backend/app/auth.py, docs/20-render-deployment.md) ----
# Required everywhere — local dev, tests, and production alike. The app
# refuses to start without both (see app/main.py). There is no bypass.

# bcrypt hash of the single shared login password. Generate with:
#   python backend/scripts/hash_password.py
# Never put the plaintext password here — only the hash.
APP_AUTH_PASSWORD_HASH=

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SESSION_SECRET=

# Controls only whether the session cookie is marked `Secure` (HTTPS-only).
# Leave unset ("development") for local http://localhost. Set to
# "production" on Render (see render.yaml) — plain http will not receive
# the cookie back once this is "production".
APP_ENV=

# Only needed if the frontend is ever deployed as a separate origin from
# this backend (docs/20 "Alternative: two-service deployment"). Comma-
# separated exact origins, e.g. https://cp-enterprise-frontend.onrender.com.
# Leave unset for the default same-origin deployment.
APP_CORS_ORIGINS=
